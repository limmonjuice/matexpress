# Neon connection string (Neon console → Connect → pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth: any random string of 32+ chars, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# In production this must be the real https:// address. See SECURITY.md.
BETTER_AUTH_URL="http://localhost:3000"

# Shows controls on the order page that do the sellers' and driver's part, for demos.
# Anyone who can open an order can use them, so leave this unset for real customers.
# ORDER_TIMELINE="demo"
